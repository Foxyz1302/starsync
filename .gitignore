# Dart / Flutter generated — applies at every level of this monorepo
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
coverage/
**/doc/api/

# Flutter ephemeral build outputs
**/flutter/ephemeral/
**/Flutter/GeneratedPluginRegistrant.*
**/ios/Flutter/.last_build_id

# Build artifacts that should never be committed
*.tar.gz
*.zip
/dist/
app.*.symbols
app.*.map.json

# Logs
*.log

# Local-only agent draft lists (raw wishlists; translated into docs by an
# agent, never committed) — see AGENTS.md
docs/Wishlist.md
docs/drafts/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# OS
.DS_Store
Thumbs.db

# Misc
*.swp
*.pyc

# Claude Code session files and agent worktrees
.claude/
