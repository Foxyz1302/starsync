 #include <gdk/gdkwayland.h>
 #include <gdk/gdkx.h>
 
+// Flutter >= 3.38 keeps its EGL contexts on the raster thread, so nothing is
+// current on the platform thread (where |video_output_new| runs). Open the
+// display the way Flutter's FlOpenGLManager does: EGL hands back the same
+// EGLDisplay for the same platform and native display, which the EGLImage
+// shared in |texture_gl_populate_texture| needs. eglGetPlatformDisplayEXT is
+// looked up by hand: epoxy's dispatch for it needs a current display.
+static EGLDisplay flutter_egl_display() {
+  typedef EGLDisplay (*GetPlatformDisplay)(EGLenum, void*, const EGLint*);
+  GetPlatformDisplay get_platform_display =
+      (GetPlatformDisplay)eglGetProcAddress("eglGetPlatformDisplayEXT");
+  if (get_platform_display == NULL) {
+    return EGL_NO_DISPLAY;
+  }
+  EGLDisplay egl_display = EGL_NO_DISPLAY;
+  GdkDisplay* display = gdk_display_get_default();
+  if (GDK_IS_WAYLAND_DISPLAY(display)) {
+    egl_display = get_platform_display(
+        EGL_PLATFORM_WAYLAND_EXT, gdk_wayland_display_get_wl_display(display),
+        NULL);
+  } else if (GDK_IS_X11_DISPLAY(display)) {
+    egl_display = get_platform_display(
+        EGL_PLATFORM_X11_EXT, gdk_x11_display_get_xdisplay(display), NULL);
+  }
+  if (egl_display != EGL_NO_DISPLAY &&
+      !eglInitialize(egl_display, NULL, NULL)) {
+    egl_display = EGL_NO_DISPLAY;
+  }
+  return egl_display;
+}
+
+void video_output_glx_release(VideoOutputGlxState* state) {
+  *state = VideoOutputGlxState{};
+  // On X11, GDK draws Flutter's view with GLX on the platform thread, and
+  // libglvnd refuses an EGL context (EGL_BAD_ACCESS) on a thread holding a
+  // GLX one: step it aside while ours is in use.
+  if (!GDK_IS_X11_DISPLAY(gdk_display_get_default()) ||
+      glXGetCurrentContext() == NULL) {
+    return;
+  }
+  state->display = glXGetCurrentDisplay();
+  state->draw = glXGetCurrentDrawable();
+  state->read = glXGetCurrentReadDrawable();
+  state->context = glXGetCurrentContext();
+  glXMakeContextCurrent(state->display, None, None, NULL);
+}
+
+void video_output_glx_restore(VideoOutputGlxState* state) {
+  if (state->context != NULL) {
+    glXMakeContextCurrent(state->display, state->draw, state->read,
+                          state->context);
+  }
+}
+
+void video_output_restore_egl_context(EGLDisplay own_display,
+                                      EGLDisplay display,
+                                      EGLSurface draw,
+                                      EGLSurface read,
+                                      EGLContext context) {
+  // Nothing was current (the platform thread): release ours, or it stays
+  // current here and the raster thread cannot make it current (BadAccess).
+  if (context == EGL_NO_CONTEXT) {
+    eglMakeCurrent(own_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                   EGL_NO_CONTEXT);
+  } else {
+    eglMakeCurrent(display, draw, read, context);
+  }
+}
